# ---------------------------------------------------------------------------
# VISION API configuration
# Copy this file to server/.env and fill in values. Never commit server/.env.
# ---------------------------------------------------------------------------

# HTTP
PORT=5000
NODE_ENV=development
# Comma separated list of allowed browser origins. Use * only for local demos.
CORS_ORIGIN=http://localhost:5173
# TRUST_PROXY=false

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Supabase (server-side only; the service role key must never reach the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
PHOTOS_BUCKET=vision
AVATARS_BUCKET=avatars

# Uploads
MAX_UPLOAD_MB=15
# UPLOAD_DIR=./uploads
# TEMP_DIR=./tmp

# Face pipeline
FACE_MODEL=buffalo_l
FACE_MATCH_THRESHOLD=0.6
# -1 = CPU. Set to the GPU device id (0) when onnxruntime-gpu is installed.
FACE_CTX_ID=-1
FACE_DET_SIZE=640
FACE_WARMUP=true
# Optional explicit interpreter path (defaults to python/venv/... auto-detection)
# PYTHON_EXECUTABLE=C:/Projects/VISION/python/venv/Scripts/python.exe

# Album video renderer
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_SECONDS_PER_PHOTO=4
VIDEO_DOWNLOAD_CONCURRENCY=4

# Logging: error | warn | info | debug
LOG_LEVEL=debug
